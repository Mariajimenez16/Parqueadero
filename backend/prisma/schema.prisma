generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  nombre       String
  apellidos    String
  documento    String   @unique
  correo       String   @unique
  telefono     String
  passwordHash String
  userType     String   @default("ESTUDIANTE") // ESTUDIANTE, DOCENTE, ADMINISTRATIVO, VISITANTE
  role         String   @default("USUARIO")    // ADMIN, VIGILANTE, CAJERO, USUARIO
  status       String   @default("ACTIVO")     // ACTIVO, BLOQUEADO, INACTIVO
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles          Vehicle[]
  reservations      Reservation[]
  movements         Movement[]   @relation("UserMovements")
  operatorMovements Movement[]   @relation("OperatorMovements")
  payments          Payment[]    @relation("CashierPayments")
  auditLogs         AuditLog[]

  @@map("users")
}

model Vehicle {
  id          String   @id @default(uuid())
  placa       String   @unique
  type        String   @default("AUTOMOVIL") // AUTOMOVIL, MOTOCICLETA, BICICLETA, ELECTRICO
  marca       String
  modelo      String
  color       String
  qrCodeToken String   @unique @default(uuid())
  status      String   @default("AUTORIZADO") // AUTORIZADO, NO_AUTORIZADO, INACTIVO
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations Reservation[]
  movements    Movement[]

  @@map("vehicles")
}

model Space {
  id        String   @id @default(uuid())
  codigo    String   @unique // Ej: A-01, M-05
  numero    Int
  tipo      String   @default("AUTOMOVIL") // AUTOMOVIL, MOTOCICLETA, PREFERENCIAL
  zona      String   // Ej: Zona A - Norte
  estado    String   @default("DISPONIBLE") // DISPONIBLE, OCUPADO, RESERVADO, MANTENIMIENTO, INACTIVO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
  movements    Movement[]

  @@map("spaces")
}

model Tariff {
  id            String   @id @default(uuid())
  userType      String   // ESTUDIANTE, DOCENTE, ADMINISTRATIVO, VISITANTE
  vehicleType   String   // AUTOMOVIL, MOTOCICLETA, BICICLETA, ELECTRICO
  valorHora     Float
  valorMinimo   Float
  valorMaximo   Float?
  estado        Boolean  @default(true)
  fechaVigencia DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments Payment[]

  @@unique([userType, vehicleType])
  @@map("tariffs")
}

model Reservation {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  spaceId       String
  space         Space    @relation(fields: [spaceId], references: [id])
  fecha         DateTime
  horaInicio    DateTime
  horaFin       DateTime
  estado        String   @default("PENDIENTE") // PENDIENTE, CONFIRMADA, ACTIVA, FINALIZADA, CANCELADA
  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("reservations")
}

model Movement {
  id              String    @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id])
  userId          String
  user            User      @relation("UserMovements", fields: [userId], references: [id])
  spaceId         String
  space           Space     @relation(fields: [spaceId], references: [id])
  operatorId      String
  operator        User      @relation("OperatorMovements", fields: [operatorId], references: [id])
  entryTime       DateTime  @default(now())
  exitTime        DateTime?
  duracionMinutos Int?
  estado          String    @default("DENTRO") // DENTRO, FINALIZADO
  observaciones   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payment Payment?

  @@map("movements")
}

model Payment {
  id            String    @id @default(uuid())
  movementId    String    @unique
  movement      Movement  @relation(fields: [movementId], references: [id])
  tariffId      String?
  tariff        Tariff?   @relation(fields: [tariffId], references: [id])
  cashierId     String?
  cashier       User?     @relation("CashierPayments", fields: [cashierId], references: [id])
  valorTotal    Float
  metodoPago    String    @default("EFECTIVO") // EFECTIVO, TARJETA_DEBITO, TARJETA_CREDITO, PAGO_DIGITAL
  estado        String    @default("PENDIENTE") // PENDIENTE, PAGADO, CANCELADO, FALLIDO
  numeroFactura String    @unique
  fechaPago     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("payments")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  accion    String   // REGISTRO_ENTRADA, REGISTRO_SALIDA, REGISTRO_PAGO, BLOQUEO_USUARIO, CAMBIO_TARIFA, MODIFICACION_ESPACIO, CANCELACION_RESERVA
  entidad   String   // Movement, User, Tariff, Reservation, Space, Payment
  entidadId String?
  detalles  String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
