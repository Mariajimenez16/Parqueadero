flowchart TB
    subgraph Client[🌐 Client Layer]
        direction LR
        A[Web Application<br/>Responsive UI]
        B[Mobile Application<br/>Cross-Platform]
        C[API Clients<br/>Third-party Integrations]
    end

    subgraph LoadBalancer[⚖️ Load Balancer & Gateway]
        LB[Load Balancer<br/>Nginx/ALB]
        GW[API Gateway<br/>Rate Limiting & Routing]
    end

    subgraph API[🔌 API Layer]
        direction LR
        D[REST API<br/>JSON/HTTP]
        E[GraphQL API<br/>Flexible Queries]
        F[WebSocket<br/>Real-time Communication]
    end

    subgraph Middleware[🔒 Middleware & Security]
        AUTH[Authentication<br/>JWT/OAuth2]
        VAL[Validation<br/>Input Sanitization]
        RATE[Rate Limiting<br/>Request Throttling]
        LOG[Logging<br/>Audit Trail]
    end

    subgraph Business[⚙️ Business Logic Layer]
        direction LR
        G[Controllers<br/>Request Handlers]
        H[Services<br/>Business Rules]
        I[Validators<br/>Data Validation]
        J[Helpers<br/>Utility Functions]
    end

    subgraph Data[💾 Data Layer]
        direction LR
        K[(Primary Database<br/>PostgreSQL/MySQL)]
        L[(Cache Layer<br/>Redis/Memcached)]
        M[(File Storage<br/>S3/Local)]
    end

    subgraph External[🔗 External Services]
        direction LR
        N[Auth Provider<br/>OAuth/SAML]
        O[Payment Gateway<br/>Stripe/PayPal]
        P[Email Service<br/>SMTP/SendGrid]
        Q[Analytics<br/>Metrics & Logs]
    end

    subgraph Async[🔄 Async Processing]
        direction LR
        R[Message Queue<br/>RabbitMQ/Kafka]
        S[Background Workers<br/>Celery/Redis Queue]
    end

    %% Client to Load Balancer
    A --> LB
    B --> LB
    C --> LB

    %% Load Balancer to API
    LB --> GW
    GW --> D
    GW --> E
    GW --> F

    %% API to Middleware
    D --> AUTH
    E --> AUTH
    F --> AUTH
    AUTH --> VAL
    VAL --> RATE
    RATE --> LOG

    %% Middleware to Business Logic
    LOG --> G
    G --> H
    H --> I
    I --> J

    %% Business Logic to Data
    J --> K
    H --> L
    H --> M

    %% Business Logic to External
    G --> N
    H --> O
    H --> P
    G --> Q

    %% Async Processing
    H --> R
    R --> S
    S --> K

    %% Styling for professional appearance
    style Client fill:#4A90E2,color:#fff,stroke:#2E5C8A,stroke-width:2px
    style LoadBalancer fill:#F5A623,color:#fff,stroke:#C78419,stroke-width:2px
    style API fill:#7ED321,color:#fff,stroke:#5BA818,stroke-width:2px
    style Middleware fill:#D0021B,color:#fff,stroke:#9E0016,stroke-width:2px
    style Business fill:#9013FE,color:#fff,stroke:#6B0FB8,stroke-width:2px
    style Data fill:#50E3C2,color:#000,stroke:#3BB89F,stroke-width:2px
    style External fill:#F8E71C,color:#000,stroke:#C4B519,stroke-width:2px
    style Async fill:#BD10E0,color:#fff,stroke:#8A0BA8,stroke-width:2px

    classDef default fill:#fff,stroke:#333,stroke-width:1px
